{
  "rewrites": [
    {
      "source": "/api/backend/:path*",
      "destination": "https://mediumorchid-zebra-535607.hostingersite.com/backend/endpoints/:path*"
    },
    {
      "source": "/img/:path*",
      "destination": "https://mediumorchid-zebra-535607.hostingersite.com/uploads/:path*"
    },
    {
      "source": "/api/file/:path*",
      "destination": "https://mediumorchid-zebra-535607.hostingersite.com/backend/endpoints/file.php?f=:path*"
    },
    {
      "source": "/pengurus/:path*",
      "destination": "/Pengurus/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
